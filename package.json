  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon ./index.js",
    "build:backend": "cmd /C \"rd /s /q build 2>nul & mkdir build & copy package.json build\\ && copy package-lock.json build\\ && copy index.js build\\ && xcopy backend\\* build\\backend\\ /E /Y /I\"",
    "install:backend": "cmd /C \"cd build && npm ci --omit=dev\"",
    "build:frontend": "npm run build --prefix frontend",
    "fullbuild": "npm run build:backend && npm run install:backend && npm run build:frontend",
    "build": "npm run build:backend && npm run build:frontend"
  },
