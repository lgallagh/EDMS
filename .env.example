#The port the application will be running under
APP_PORT="8083"
#Configuring the path that front end content will be served from. For production deployment, this should be an empty string
APP_PATH="/build"
#This should be any string that needs to be prepended to the Express routes for the API calls when deployed.
#API_PATH="/quickq"
#Database configuration should use the following format: `•	{"user": "<database username> ",  "password": "<database password>", "database": "<specific database name>", "server": "<server name>",  "pool": {"max": 10, "min": 0,                        "idleTimeoutMillis": 30000}, "options": {"trustServerCertificate": true}}`
ENTA_DB_CONFIG=`{"user": "ent_live",  "password": "6M7bg1#j", "database": "ent_live", "server": "entawebsqltst",  "pool": {"max": 10, "min": 2,"idleTimeoutMillis": 30000}, "options": {"trustServerCertificate": true}}`
#Secret string that will be used for authenticating access tokens
AUTH_KEY="1234567890ABC"
#Timeout in seconds for access token
#AUTH_EXPIRES=600
AUTH_EXPIRES=12000
#Secret string that will be used for authenticating refresh tokens
REFRESH_KEY="0987654321CBA"
#Timeout in seconds for refresh token
REFRESH_EXPIRES=12000
#Controlling the types of messages that will be written to the log. "debug"/"info"/"error"
LOG_FILE_LEVEL="debug"
#Path to the general application log
LOG_FILE_PATH="U:\logs\edms.log"
#Path to the errors only log
ERROR_LOG_FILE_PATH="U:\logs\edms-error.log"
#Maximum size in bytes before logs rotate
#LOG_FILE_MAX_SIZE=5242880
LOG_FILE_MAX_SIZE=2048
#Maximum number of log files to keep when rotating
LOG_FILE_MAX_FILES=5
#Formatting to use for building Winston log messages
LOG_FORMAT=`{timestamp} [{level}]: {message} {stack} {newline}`
#Working directory for file generation
TEMP_FILE_DIR="U:\temp\edms"
#Base Upload File Directory
UPLOAD_FILE_DIR="U:\temp\edms\userfiles"
#This is the root path within the application that will be used for serving static files from the above directory through the app
UPLOAD_FILE_SERVE_PATH="userfiles"
#This is the subfolder under which files for particular pages are stored
DOCTOR_FILE_PATH="/providers"
PHYSICIAN_FILE_PATH="/physicians"
AUDIOLOGIST_FILE_PATH="/providers"
SLP_FILE_PATH="/slps"
PROVIDER_FILE_PATH="/providers"
SERVICE_FILE_PATH="/services"
BANNER_FILE_PATH="/banners"
SERVICE_MENU_FILE_PATH="/menu-services"
SERVICE_LIST_FILE_PATH="/list-services"
SERVICE_BANNER_FILE_PATH="/banner-services"
CMS_PAGES_FILE_PATH="/cmspages"
OFFICE_FILE_PATH="/office_files"
#Set to “true” if application will be running under HTTPS, "false" otherwise
SECURE_COOKIE="false"
#Base URL the front end app will be running under. Needed when running in development with server and client on different ports, not required in prod
ORIGIN="http://127.0.0.1:3002"
#Making stored procedure names configurable, so name changes can just be made here, instead of looking through the code for references
PROC_PREFIX="CMS"
